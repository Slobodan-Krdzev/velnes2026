# /srv/velnes/api/.env on the VPS — mode 600, never in git.
# The API refuses to start in production without API_DATABASE_URL and
# JWT_SECRET. Every URL is the public origin of that app on Vercel.

NODE_ENV=production
PORT=6000
HOST=127.0.0.1
# Trust X-Forwarded-* from Nginx on the same box (default when unset).
TRUST_PROXY=127.0.0.1

# The restricted API role (row-level security always applies).
API_DATABASE_URL=postgres://velnes_api:CHANGE_ME_2@127.0.0.1:5432/velnes?sslmode=disable
# The owning role — dbmate migrations and the HQ bootstrap only.
DATABASE_URL=postgres://velnes:CHANGE_ME_1@127.0.0.1:5432/velnes?sslmode=disable

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME

CONSUMER_APP_URL=https://velnes.example
EMPLOYEE_APP_URL=https://employee.velnes.example
WORKSPACE_APP_URL=https://app.velnes.example
HQ_APP_URL=https://hq.velnes.example
SUPPLIER_APP_URL=https://supplier.velnes.example

# Mail through Resend; MAIL_FROM on a domain verified in Resend.
RESEND_API_KEY=CHANGE_ME
MAIL_FROM="Velnes <no-reply@velnes.example>"
MAIL_REPLY_TO=
