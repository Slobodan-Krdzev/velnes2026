# Copy to .env and fill in. Never commit .env.
# Local dev DB: native Homebrew Postgres 16 (brew services start postgresql@16)

# Admin connection: dbmate migrations (needs CREATEROLE for 0001).
DATABASE_URL=postgres://velnes:velnes@localhost:5432/velnes?sslmode=disable

# Restricted connection the API uses (RLS always enforced).
API_DATABASE_URL=postgres://velnes_api:velnes_api@localhost:5432/velnes?sslmode=disable

# RLS-exempt connection for seeding (superuser or BYPASSRLS role).
SEED_DATABASE_URL=postgres://<your-mac-username>@localhost:5432/velnes

# Tests (velnes_test database is created/migrated/seeded automatically).
TEST_SEED_DATABASE_URL=postgres://<your-mac-username>@localhost:5432/velnes_test

# Where the consumer app is served — the base of the links in customer
# mails and notifications (appointment page, payment screen).
CONSUMER_APP_URL=http://localhost:5178

# Where the employee app is served — the base of the personal sign-in
# links the workspace mints for team members.
EMPLOYEE_APP_URL=http://localhost:5174
# The staff apps, for the buttons in invites, reminders and orders.
WORKSPACE_APP_URL=http://localhost:5173
HQ_APP_URL=http://localhost:5177
SUPPLIER_APP_URL=http://localhost:5176

# Mail. 'mock' (dev/tests): rows land in mail_outbox as mock_sent and
# nothing is sent. 'smtp': the outbox is delivered over SMTP — any
# provider (Resend: smtp.resend.com, user "resend", pass = API key;
# Brevo, Mailgun, Postmark, Google Workspace app password, your host).
MAIL_TRANSPORT=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Velnes <no-reply@example.com>"
MAIL_REPLY_TO=

# Secrets
JWT_SECRET=change-me-in-production
PORT=3001
