# Salon Workspace — build/runtime config (Vite reads .env from this dir).
# Copy to apps/workspace/.env and fill in. All keys must start with VITE_.

# Revelapps HQ's WhatsApp support number, in international format.
# Set it to switch on the "Chat on WhatsApp" click-to-chat button on the
# support screen (a wa.me deep link). Leave empty and no button shows —
# nothing fake ships until a real number is set.
VITE_SUPPORT_WHATSAPP=
